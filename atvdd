alturas = []
homens = []
mulheres = 0

for i in range(15):
    altura = float(input("Digite a altura: "))
    genero = input("Digite o genero: ")

    alturas.append(altura)

    if genero == "Masculino":
        homens.append(altura)

    if genero == "Feminino":
        mulheres += 1

maior = alturas[0]
menor = alturas[0]

for altura in alturas:
    if altura > maior:
        maior = altura

    if altura < menor:
        menor = altura

soma = 0

for altura in homens:
    soma += altura

if len(homens) > 0:
    media = soma / len(homens)
else:
    media = 0

print("Maior altura:", maior)
print("Menor altura:", menor)
print("Media dos homens:", media)
print("Quantidade de mulheres:", mulheres)
